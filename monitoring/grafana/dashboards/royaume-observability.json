{
  "uid": "royaume-observ",
  "title": "Royaume - Observabilite",
  "tags": [
    "royaume",
    "prometheus",
    "elasticsearch"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 6,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(up, instance)",
        "query": "label_values(up, instance)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "options": [],
        "regex": "",
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 2,
      "type": "timeseries",
      "title": "Nombre de qu\u00eates en cours",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "gradientMode": "opacity",
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "quest_status_count{status=\"RECEIVED\",instance=~\"$instance\"}",
          "legendFormat": "RECEIVED"
        },
        {
          "expr": "quest_status_count{status=\"PROCESSING\",instance=~\"$instance\"}",
          "legendFormat": "PROCESSING"
        },
        {
          "expr": "quest_status_count{status=\"RESOLVED\",instance=~\"$instance\"}",
          "legendFormat": "RESOLVED"
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Erreurs API partenaire (5m, count)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(tasks_scheduled_execution_seconds_count{outcome=\"ERROR\"}[5m])) or on() vector(0)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Nombre de quetes en cours",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "executor_queued_tasks{name=\"taskScheduler\"}",
          "legendFormat": "queued_tasks",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "gradientMode": "opacity",
            "showPoints": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HTTP Requests (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "increase(http_server_requests_seconds_count{method=\"GET\", uri=\"/api/royaume/quests\"}[5m])",
          "legendFormat": "GET /api/royaume/quests",
          "refId": "A"
        },
        {
          "expr": "increase(http_server_requests_seconds_count{method=\"POST\", uri=\"/api/royaume/quests/{id}/launch\"}[5m])",
          "legendFormat": "POST /api/royaume/quests/{id}/launch",
          "refId": "B"
        },
        {
          "legendFormat": "POST /api/royaume/quests/{id}/resolve",
          "expr": "increase(http_server_requests_seconds_count{method=\"POST\", uri=\"/api/royaume/quests/{id}/resolve\"}[5m])",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "gradientMode": "opacity",
            "showPoints": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 (ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{method=\"GET\", uri=\"/api/royaume/quests\"}[$__rate_interval])) by (le)) * 1000",
          "legendFormat": "GET /api/royaume/quests",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{method=\"POST\", uri=\"/api/royaume/quests/{id}/launch\"}[$__rate_interval])) by (le)) * 1000",
          "legendFormat": "POST /api/royaume/quests/{id}/launch",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{method=\"POST\", uri=\"/api/royaume/quests/{id}/resolve\"}[$__rate_interval])) by (le)) * 1000",
          "legendFormat": "POST /api/royaume/quests/{id}/resolve",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "gradientMode": "opacity",
            "showPoints": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p99 (ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{method=\"GET\", uri=\"/api/royaume/quests\"}[$__rate_interval])) by (le)) * 1000",
          "legendFormat": "GET /api/royaume/quests",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{method=\"POST\", uri=\"/api/royaume/quests/{id}/launch\"}[$__rate_interval])) by (le)) * 1000",
          "legendFormat": "POST /api/royaume/quests/{id}/launch",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{method=\"POST\", uri=\"/api/royaume/quests/{id}/resolve\"}[$__rate_interval])) by (le)) * 1000",
          "legendFormat": "POST /api/royaume/quests/{id}/resolve",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "gradientMode": "opacity",
            "showPoints": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Application Logs",
      "datasource": {
        "type": "elasticsearch",
        "uid": "elasticsearch"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "query": "*",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "logs"
            }
          ],
          "bucketAggs": []
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "showLogMessage": true,
        "wrapLogMessage": true
      }
    }
  ]
}